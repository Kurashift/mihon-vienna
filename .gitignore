# Build files

.gradle
.kotlin
build
/outputs

# IDE files
*.iml
.idea/*
!.idea/icon.svg
/captures

# Configuration files
keystore.properties
local.properties

# 本地密钥（token / 密码 / 签名密钥），严禁提交。
# 新增同类文件时必须同步在此登记。
secrets.properties
*.secrets.properties
*_token.txt
*.jks
*.keystore

# macOS specific files
.DS_Store

# Local debug screenshots and icon previews (repo root only)
/current-screen*.png
/current-screen*.jpg
/device-*.png
/icon-preview*.png
/icon-preview*.svg

# Agent / IDE local state (never commit)
.codebuddy/
.dsh/
.zcode/
__pycache__/
*.pyc
gradle/build-logic/bin/

# Throwaway artifacts in the repo root: build/install logs, one-off scripts,
# scratch exports. Real documentation belongs in docs/.
/_*.log
/_*.json
/_ctx_out/
/generated-images/

# 临时垃圾目录：下横线开头、英文命名（如 _tmp/）。所有临时产物都集中在这里，
# 任务结束整个删掉。见 AGENTS.md「文档与工作区卫生」。
/_*/

# JVM crash dumps. A test JVM that dies from memory pressure drops these beside
# whichever module it was running for, not in the root.
hs_err_pid*.log
replay_pid*.log
