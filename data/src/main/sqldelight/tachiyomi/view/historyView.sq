CREATE VIEW historyView AS
SELECT
    history._id AS id,
    mangas._id AS mangaId,
    chapters._id AS chapterId,
    mangas.title,
    mangas.thumbnail_url AS thumbnailUrl,
    mangas.source,
    mangas.favorite,
    mangas.cover_last_modified,
    mangas.chapter_flags AS chapterFlags,
    chapters.chapter_number AS chapterNumber,
    chapters.name AS chapterName,
    chapters.translated_name AS chapterTranslatedName,
    chapters.url AS chapterUrl,
    chapters.version AS chapterVersion,
    chapters.date_upload AS chapterDateUpload,
    chapters.last_modified_at AS chapterLastModifiedAt,
    history.last_read AS readAt,
    history.time_read AS readDuration,
    chapters.last_page_read AS chapterLastPageRead,
    chapters.total_pages AS chapterTotalPages,
    chapters.read AS chapterRead,
    max_last_read.last_read AS maxReadAt,
    max_last_read.chapter_id AS maxReadAtChapterId
FROM mangas
JOIN chapters
ON mangas._id = chapters.manga_id
JOIN reading_chapter_link
ON chapters._id = reading_chapter_link.chapter_id
JOIN history
ON reading_chapter_link.record_key = history.record_key
JOIN (
    SELECT chapters.manga_id,chapters._id AS chapter_id, MAX(history.last_read) AS last_read
    FROM chapters JOIN reading_chapter_link ON chapters._id = reading_chapter_link.chapter_id
    JOIN history ON reading_chapter_link.record_key = history.record_key
    WHERE history.hidden = 0
    GROUP BY chapters.manga_id
) AS max_last_read
ON chapters.manga_id = max_last_read.manga_id;

history:
SELECT
id,
mangaId,
chapterId,
title,
thumbnailUrl,
source,
favorite,
cover_last_modified,
chapterFlags,
chapterNumber,
chapterName,
chapterTranslatedName,
chapterUrl,
chapterVersion,
chapterDateUpload,
chapterLastModifiedAt,
readAt,
readDuration,
chapterLastPageRead,
chapterTotalPages,
chapterRead
FROM historyView
WHERE historyView.readAt > 0
AND id IN (SELECT _id FROM history WHERE hidden = 0)
AND maxReadAtChapterId = historyView.chapterId
AND lower(historyView.title) LIKE ('%' || :query || '%')
ORDER BY readAt DESC;

getLatestHistory:
SELECT
id,
mangaId,
chapterId,
title,
thumbnailUrl,
source,
favorite,
cover_last_modified,
chapterFlags,
chapterNumber,
chapterName,
chapterTranslatedName,
chapterUrl,
chapterVersion,
chapterDateUpload,
chapterLastModifiedAt,
readAt,
readDuration,
chapterLastPageRead,
chapterTotalPages,
chapterRead
FROM historyView
WHERE historyView.readAt > 0
AND id IN (SELECT _id FROM history WHERE hidden = 0)
ORDER BY readAt DESC
LIMIT 1;
