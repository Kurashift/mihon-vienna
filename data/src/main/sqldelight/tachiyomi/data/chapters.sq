import kotlin.Boolean;
import kotlinx.serialization.json.JsonObject;

CREATE TABLE chapters(
    _id INTEGER NOT NULL PRIMARY KEY,
    manga_id INTEGER NOT NULL,
    url TEXT NOT NULL,
    name TEXT NOT NULL,
    scanlator TEXT,
    read INTEGER AS Boolean NOT NULL,
    bookmark INTEGER AS Boolean NOT NULL,
    last_page_read INTEGER NOT NULL,
    chapter_number REAL NOT NULL,
    source_order INTEGER NOT NULL,
    date_fetch INTEGER NOT NULL,
    date_upload INTEGER NOT NULL,
    last_modified_at INTEGER NOT NULL DEFAULT 0,
    version INTEGER NOT NULL DEFAULT 0,
    is_syncing INTEGER NOT NULL DEFAULT 0,
    memo BLOB AS JsonObject NOT NULL DEFAULT '{}',
    total_pages INTEGER NOT NULL DEFAULT 0,
    custom_order INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(manga_id) REFERENCES mangas (_id)
    ON DELETE CASCADE
);

CREATE INDEX chapters_manga_id_index ON chapters(manga_id);
CREATE INDEX chapters_unread_by_manga_index ON chapters(manga_id, read) WHERE read = 0;
CREATE INDEX idx_chapters_url ON chapters(url);

CREATE TRIGGER update_last_modified_at_chapters
AFTER UPDATE ON chapters
FOR EACH ROW
BEGIN
  UPDATE chapters
  SET last_modified_at = strftime('%s', 'now')
  WHERE _id = new._id;
END;

CREATE TRIGGER update_chapter_and_manga_version AFTER UPDATE ON chapters
WHEN new.is_syncing = 0 AND (
    new.read != old.read OR
    new.bookmark != old.bookmark OR
    new.last_page_read != old.last_page_read
)
BEGIN
    -- Update the chapter version
    UPDATE chapters SET version = version + 1
    WHERE _id = new._id;

    -- Update the manga version
    UPDATE mangas SET version = version + 1
    WHERE _id = new.manga_id AND (SELECT is_syncing FROM mangas WHERE _id = new.manga_id) = 0;
END;

getChapterById:
SELECT *
FROM chapters
WHERE _id = :id;

getChaptersByMangaId:
SELECT C.*
FROM chapters C
LEFT JOIN excluded_scanlators ES
ON C.manga_id = ES.manga_id
AND C.scanlator = ES.scanlator
WHERE C.manga_id = :mangaId
AND (
    :applyScanlatorFilter = 0
    OR ES.scanlator IS NULL
);

getChaptersByMangaIds:
SELECT C.*
FROM chapters C
LEFT JOIN excluded_scanlators ES
ON C.manga_id = ES.manga_id
AND C.scanlator = ES.scanlator
WHERE C.manga_id IN :mangaIds
AND (
    :applyScanlatorFilter = 0
    OR ES.scanlator IS NULL
);

getScanlatorsByMangaId:
SELECT scanlator
FROM chapters
WHERE manga_id = :mangaId;

getBookmarkedChaptersByMangaId:
SELECT *
FROM chapters
WHERE bookmark
AND manga_id = :mangaId;

getChapterByUrl:
SELECT *
FROM chapters
WHERE url = :chapterUrl;

getChapterByUrlAndMangaId:
SELECT *
FROM chapters
WHERE url = :chapterUrl
AND manga_id = :mangaId
LIMIT 1;

removeChaptersWithIds:
DELETE FROM chapters
WHERE _id IN :chapterIds;

resetIsSyncing:
UPDATE chapters
SET is_syncing = 0
WHERE is_syncing = 1;

insert:
INSERT INTO chapters(manga_id, url, name, scanlator, read, bookmark, last_page_read, total_pages, custom_order, chapter_number, source_order, date_fetch, date_upload, last_modified_at, version, is_syncing, memo)
VALUES (
    :mangaId,
    :url,
    :name,
    :scanlator,
    :read,
    :bookmark,
    CASE WHEN :read = 1 AND :totalPages > 0 THEN :totalPages ELSE :lastPageRead END,
    :totalPages,
    :customOrder,
    :chapterNumber,
    :sourceOrder,
    :dateFetch,
    :dateUpload,
    0,
    :version,
    0,
    :memo
);

insertReturningId:
INSERT INTO chapters(manga_id, url, name, scanlator, read, bookmark, last_page_read, total_pages, custom_order, chapter_number, source_order, date_fetch, date_upload, last_modified_at, version, is_syncing, memo)
VALUES (
    :mangaId,
    :url,
    :name,
    :scanlator,
    :read,
    :bookmark,
    CASE WHEN :read = 1 AND :totalPages > 0 THEN :totalPages ELSE :lastPageRead END,
    :totalPages,
    :customOrder,
    :chapterNumber,
    :sourceOrder,
    :dateFetch,
    :dateUpload,
    0,
    :version,
    0,
    :memo
)
RETURNING _id;

update:
UPDATE chapters
SET manga_id = coalesce(:mangaId, manga_id),
    url = coalesce(:url, url),
    name = coalesce(:name, name),
    scanlator = coalesce(:scanlator, scanlator),
    read = coalesce(:read, read),
    bookmark = coalesce(:bookmark, bookmark),
    last_page_read = CASE
        WHEN coalesce(:totalPages, total_pages) > 0
            AND coalesce(:read, read) = 1
            THEN coalesce(:totalPages, total_pages)
        WHEN :totalPages IS NOT NULL
            AND :totalPages > 0
            AND total_pages <= 0
            AND coalesce(:read, read) = 0
            AND coalesce(:lastPageRead, last_page_read) >= :totalPages
            THEN 0
        ELSE coalesce(:lastPageRead, last_page_read)
    END,
    total_pages = coalesce(:totalPages, total_pages),
    custom_order = coalesce(:customOrder, custom_order),
    chapter_number = coalesce(:chapterNumber, chapter_number),
    source_order = coalesce(:sourceOrder, source_order),
    date_fetch = coalesce(:dateFetch, date_fetch),
    date_upload = coalesce(:dateUpload, date_upload),
    version = coalesce(:version, version),
    is_syncing = coalesce(:isSyncing, is_syncing),
    memo = coalesce(:memo, memo)
WHERE _id = :chapterId;

updateReaderProgress:
UPDATE chapters
SET read = CASE
        WHEN read = 1 OR :completed = 1 THEN 1
        ELSE 0
    END,
    last_page_read = CASE
        WHEN read = 1 OR :completed = 1 THEN
            CASE
                WHEN :totalPages > 0 THEN :totalPages
                WHEN total_pages > 0 THEN total_pages
                ELSE max(last_page_read, :pageNumber)
            END
        ELSE :pageNumber
    END,
    total_pages = CASE
        WHEN :totalPages > 0 THEN :totalPages
        ELSE total_pages
    END
WHERE _id = :chapterId;

setAllChaptersUnreadBySource:
UPDATE chapters
SET read = 0, last_page_read = 0
WHERE manga_id IN (
    SELECT _id FROM mangas WHERE source = :sourceId
);

setAllChaptersUnreadByMangaIds:
UPDATE chapters
SET read = 0, last_page_read = 0
WHERE manga_id IN :mangaIds;

getMangaProgressBySource:
SELECT
    mangas._id AS manga_id,
    mangas.url AS manga_url,
    count(*) AS total_chapters,
    CAST(coalesce(sum(CASE WHEN chapters.read = 1 OR chapters.last_page_read > 2 THEN 1 ELSE 0 END), 0) AS INTEGER) AS read_count,
    CAST(coalesce(sum(CASE WHEN chapters.read = 1 THEN 1 ELSE 0 END), 0) AS INTEGER) AS finished_count,
    coalesce(max(CASE WHEN chapters.read = 1 OR chapters.last_page_read > 2 THEN history.last_read END), 0) AS last_read,
    coalesce(max(history.last_read), 0) AS last_opened_at
FROM mangas
JOIN chapters
ON mangas._id = chapters.manga_id
LEFT JOIN history
ON chapters._id = history.chapter_id
WHERE mangas.source = :sourceId
GROUP BY mangas._id;
